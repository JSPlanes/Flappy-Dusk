{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flappy Dusk",
  "version": "1.0.0",
  "identifier": "com.pocketarcade.flappydusk",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Flappy Dusk",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 660,
        "backgroundColor": "#211d2c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "A dusk-themed arcade flight game",
    "publisher": "Pocket Arcade",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh",
        "startMenuFolder": "Pocket Arcade",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
